# Создайте файл .gitignore
cat > .gitignore << EOF
# Dependencies
node_modules/
.npm
.yarn
.env.local
.env.production
.env.*.local
.env.production
.env.test

# production builds
.next/
out/
dist/

# Environment variables
.env*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Database
*.db
*.sqlite
.superpowers/sdd/
.worktrees/

# Google Cloud service account key files (downloaded to project root during
# manual key rotation — must never be committed; the actual key lives only
# in GOOGLE_SERVICE_ACCOUNT_KEY in .env.production on the server)
servicebox35-e242f-*.json
*-gserviceaccount-*.json

# Локальный ledger харденинга безопасности — не коммитить
.superpowers/sec/

# Устаревшая свалка загрузок — реальное хранилище в <root>/uploads и public/uploads
src/uploads/
